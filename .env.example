# Optional for the current MVP. The deterministic generator works without keys.

# Add when replacing deterministic inference with an LLM call.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_DASHBOARD_TOKEN=

# Add for durable production persistence. DATABASE_URL works with Neon,
# Supabase Postgres, Vercel Postgres, or any Postgres-compatible provider.
DATABASE_URL=
POSTGRES_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Add when account login is enabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Add when email capture or notifications are enabled.
RESEND_API_KEY=

# Add when paid plans are enabled.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
