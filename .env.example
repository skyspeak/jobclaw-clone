# Lead gen admin dashboard: /admin/leads?key=...
LEAD_GEN_ADMIN_SECRET=

# Lead storage: Postgres when DATABASE_URL is set (recommended on Vercel).
# Optional Turso instead of Postgres. Local dev falls back to data/leads.db (SQLite).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional for the current MVP. The deterministic generator works without keys.

# Add when replacing deterministic inference with an LLM call.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini (Google AI) for /api/generate when set; otherwise deterministic inference. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default gemini-2.5-flash).
GEMINI_MODEL=

# Google web search JSON API for live job hits on /intake (after the brief). https://serper.dev
SERPER_API_KEY=

# Optional: job posting URL → markdown for /job-fit (default uses public r.jina.ai reader)
JINA_READER_BASE_URL=https://r.jina.ai/

# Add for durable production persistence (intake submissions + job listings).
# Supabase: Project Settings → Database → Connection string (URI).
# Use the "Transaction" pooler URL on Vercel/serverless (port 6543).
# If your password has @ # ! etc., either URL-encode it in DATABASE_URL or use:
DATABASE_URL=
POSTGRES_URL=
# DATABASE_HOST=aws-0-....pooler.supabase.com
# DATABASE_USER=postgres.[project-ref]
# DATABASE_PASSWORD=your-raw-password
# DATABASE_PORT=6543
# DATABASE_NAME=postgres
# Optional — not used by the app yet (persistence goes through DATABASE_URL above).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Add when account login is enabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend — StayRelevant welcome email + future weekly issues (get-hired signup).
# https://resend.com — verify your domain, then use e.g. DearCC <newsletter@dearcc.org>
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional reply-to for newsletter emails.
RESEND_REPLY_TO_EMAIL=

# Add when paid plans are enabled.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
